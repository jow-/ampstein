#!/usr/bin/env ucode

// ampstein — Ampstein OpenAI-compatible HTTP server (application entry).
//
// This is the lean application entrypoint. It does NOT contain the engine
// logic: that lives in the module share/ampstein/core.uc (ampstein.core),
// which is loaded at runtime with import(). The entry owns only:
//
//   * argv parsing (parse_args) and the parsed args object
//   * --help / --version handling (fast path: returned before any module load)
//   * the bootstrap: it pushes <prefix>/lib/*.so and <prefix>/share/*.uc
//     (relative to its own location) onto REQUIRE_SEARCH_PATH, binds
//     `global.torch = require('ampstein.torch')` (every submodule references
//     the bare `torch` identifier without importing it) and import()s the engine.
//
// Run from an install prefix (see README: `cmake --install`):
//
//   <prefix>/bin/ampstein --model DIR
//
// Endpoints handled by the engine (see src/ucode/ampstein/core.uc):
//   GET  /v1/models, /v1/models/<id>
//   POST /v1/chat/completions   (stream + non-stream, tools, reasoning)
//   POST /v1/completions        (raw prompt, stream + non-stream)
//   GET  /health

const VERSION = '0.0.1';    // keep in sync with CMakeLists.txt AMP_VERSION

function usage() {
	printf("Usage: ampstein --model DIR [options]\n\n");

	printf("Options:\n");
	printf("  --model DIR           model directory (required)\n");
	printf("  --host H              bind address (default 127.0.0.1)\n");
	printf("  --port N              bind port (default 8000)\n");
	printf("  --ctx N               context length (default 65536)\n");
	printf("  --gpus N              number of GPUs (default: all)\n");
	printf("  --split N             layers per GPU (layer split)\n");
	printf("  --chunk N             prefill chunk size (default 1024; 4096 for Qwen --tp)\n");
	printf("  --mtp N               speculative MTP window (default 3; 7 with --dflash)\n");
	printf("  --dflash DIR          DFlash 2 drafter (Qwen3.5/3.8 --tp): --mtp N is its window\n");
	printf("  --tp                  tensor parallel\n");
	printf("  --tp-share F          tensor-parallel share (two GPUs, default 0.5)\n");
	printf("  --name NAME           served model name (default: basename of --model)\n");
	printf("  --cache-ram GiB       page-locked host RAM for parked states (default 32, 0 off)\n");
	printf("  --slots N|auto        resident device slots, DeepSeek-V4 (default auto)\n");
	printf("  --slice-tokens N      time-slice a generation after N tokens (default 256, 0 off)\n");
	printf("  --slice-ms N          time-slice by wall-clock ms (default 0 off)\n");
	printf("  --reasoning-nudge N   after N reason tokens append soft close nudge (default 0 off)\n");
	printf("  --reasoning-limit Y   force-close reasoning after Y tokens (default 0 off)\n");
	printf("  --eos-hook SCRIPT     call SCRIPT when the model ends its turn\n");
	printf("  --call-hook SCRIPT    call SCRIPT when the model completes a tool call\n");
	printf("  --no-vision           disable image input\n");
	printf("  --arch ARCH           force architecture: auto|qwen35|glm5|qwen4|dsv4 (default auto)\n");
	printf("  --version             print version and exit\n");
	printf("  --help                print this help and exit\n");
}

function version() {
	printf("Ampstein %s\n", VERSION);
}

// Fast flags, before any heavy module is imported. This keeps --version /
// --help instant (torch.so and CUDA are not loaded for them).
function fast_arg_scan() {
	let argv = ARGV;
	let start = index(argv, '--');

	if (start >= 0)
		argv = slice(argv, start + 1);

	for (let i = 0; i < length(argv); i++) {
		if (argv[i] == '--version' || argv[i] == '-V') {
			version();
			exit(0);
		}
		if (argv[i] == '--help' || argv[i] == '-h') {
			usage();
			exit(0);
		}
	}
}

fast_arg_scan();

// --- argv parsing (the parsed args object handed to serve(args) ---

function parse_args() {
	let a = {
		model: null,
		host: '127.0.0.1',
		port: 8000,
		ctx: 65536,
		gpus: null,
		split: null,
		chunk: 1024,
		mtp: 3,
		draft_vocab: 0,
		reasoning_nudge: 0,
		reasoning_limit: 0,
		cache_ram: 32,
		slots: 'auto',
		slot_margin: 512,
		slice_ms: 0,
		slice_tokens: 256,
		cache_quant: null,
		reasoning_nudge_text: null,
		reasoning_close_text: null,
		eos_hook: null,
		eos_hook_max: 4,
		call_hook: null,
		call_hook_max: 3,
		name: null,
		arch: 'auto',
		vision: true,
		vision_device: 0,
		image_max_pixels: 2097152,
		image_cache: 16
	};

	let argv = ARGV;
	let start = index(argv, '--');

	if (start >= 0)
		argv = slice(argv, start + 1);

	for (let i = 0; i < length(argv); i++) {
		let k = argv[i];
		let v = argv[i + 1];

		switch (k) {
		case '--model': a.model = v; i++; break;
		case '--host': a.host = v; i++; break;
		case '--port': a.port = int(v); i++; break;
		case '--ctx': a.ctx = int(v); i++; break;
		case '--gpus': a.gpus = int(v); i++; break;
		case '--split': a.split = int(v); i++; break;
		case '--chunk': a.chunk = int(v); a.chunk_set = true; i++; break;
		case '--name': a.name = v; i++; break;
		case '--mtp': a.mtp = int(v); a.mtp_set = true; i++; break;
		case '--dflash': a.dflash = v; i++; break;
		case '--cache-mode': a.cache_mode = uc(v); i++; break;
		case '--reasoning-nudge': a.reasoning_nudge = int(v); i++; break;
		case '--reasoning-limit': a.reasoning_limit = int(v); i++; break;
		case '--eos-hook': a.eos_hook = v; i++; break;
		case '--eos-hook-max': a.eos_hook_max = int(v); i++; break;
		case '--call-hook': a.call_hook = v; i++; break;
		case '--call-hook-max': a.call_hook_max = int(v); i++; break;
		case '--cache-ram': a.cache_ram = +v; i++; break;
		case '--slots': a.slots = (v == 'auto') ? 'auto' : int(v); i++; break;
		case '--slot-margin': a.slot_margin = +v; i++; break;
		case '--slice-ms': a.slice_ms = +v; i++; break;
		case '--slice-tokens': a.slice_tokens = int(v); i++; break;
		case '--cache-quant': a.cache_quant = (v == 'off') ? 'off' : (a.cache_quant || {}); i++; break;
		case '--cache-quant-min': a.cache_quant = { ...(a.cache_quant || {}), min: int(v) }; i++; break;
		case '--cache-quant-tail': a.cache_quant = { ...(a.cache_quant || {}), tail: int(v) }; i++; break;
		case '--cache-quant-q8': a.cache_quant = { ...(a.cache_quant || {}), q8: int(v) }; i++; break;
		case '--reasoning-nudge-text': a.reasoning_nudge_text = v; i++; break;
		case '--reasoning-close-text': a.reasoning_close_text = v; i++; break;
		case '--draft-vocab': a.draft_vocab = int(v); i++; break;
		case '--arch': a.arch = v; i++; break;
		case '--no-vision': a.vision = false; break;
		case '--no-warmup': a.warmup = false; break;
		case '--vision-device': a.vision_device = int(v); i++; break;
		case '--image-max-pixels': a.image_max_pixels = int(v); i++; break;
		case '--image-cache': a.image_cache = int(v); i++; break;
		case '--tp': a.tp = true; break;
		case '--tp-share': a.tp_share = +v; i++; break;
		case '--stages': a.stages = int(v); i++; break;
		case '--dspark-window': a.dspark_window = int(v); i++; break;
		case '--layer-split': a.layer_split = true; break;
		default:
			warn(`unknown argument '${k}'\n`);
			exit(1);
		}
	}

	return a;
}

let args = parse_args();

if (args.model == null) {
	warn('ampstein: --model DIR is required (see --help)\n');
	exit(1);
}

// --- runtime bootstrap: installed layout, relocatable ---
//
//   <prefix>/bin/ampstein              this loader
//   <prefix>/lib/ampstein/torch.so     native module (RUNPATH $ORIGIN ->
//                                      torch-dist-<ver>/ next to it)
//   <prefix>/share/ampstein/*.uc       the engine (ampstein.core, ...)
//
// Everything is located relative to this script, so the prefix can be moved.
// torch is bound as the global the engine modules reference.
const root = sourcepath(0, true) + '/..';

push(REQUIRE_SEARCH_PATH, root + '/lib/*.so', root + '/share/*.uc');

global.torch = require('ampstein.torch');

const core = import('ampstein.core');

core.serve(args);
