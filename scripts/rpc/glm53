#!/bin/sh
# GLM-5.3-Flash over two hosts: the leader serves the HTTP API and holds stages 1-3 (layers 13-44, the head and the MTP
# block) on its six GPUs, the worker holds stage 0 (layers 0-12) on two. Same model directory on both hosts.
#
#   jai:  scripts/rpc/glm53 leader      (loads for ~10 min, then serves on :8041)
#   j7:   scripts/rpc/glm53 worker
#
# Overrides (environment): AMPSTEIN, MODEL, LINK, RPC_PORT, PORT, CTX, EXTRA (more options for the leader, e.g.
# "--lookup" or "--mtp 3"). Stop with SIGTERM; a restart of the leader needs the worker to dial in again (it does by
# itself). The state of a conversation parks in each host's RAM; SIGTERM saves it for the next start (hot reload).

AMPSTEIN=${AMPSTEIN:-ampstein}
MODEL=${MODEL:-/data/models/GLM-5.3-Flash-exl3-3.05bpw}
LINK=${LINK:-192.168.41.2}
RPC_PORT=${RPC_PORT:-7740}
PORT=${PORT:-8041}
CTX=${CTX:-65536}

case "$1" in
leader)
	exec $AMPSTEIN --model "$MODEL" --tp --gpus 6 --stages 3 \
		--rpc-listen $LINK:$RPC_PORT --host 0.0.0.0 --port $PORT --ctx $CTX $EXTRA
	;;
worker)
	exec $AMPSTEIN --worker --connect $LINK:$RPC_PORT --model "$MODEL" --rpc-name "$(hostname)"
	;;
*)
	echo "usage: $0 leader|worker" >&2
	exit 1
	;;
esac
